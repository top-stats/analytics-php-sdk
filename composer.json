{
    "name": "topstats/analytics",
    "description": "Official TopStats Analytics client for PHP: buffered event ingestion and feature flag evaluation over the TopStats HTTP API.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "analytics",
        "topstats",
        "events",
        "feature-flags",
        "telemetry"
    ],
    "homepage": "https://docs.topstats.gg/docs/analytics",
    "require": {
        "php": ">=8.1",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "TopStats\\Analytics\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TopStats\\Analytics\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    },
    "config": {
        "sort-packages": true
    }
}
